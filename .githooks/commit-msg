#!/bin/sh
#
# Git commit-msg hook — Conventional Commits validator
# Pattern: type(scope): subject (≤72 chars)
# Allowed types: feat, fix, docs, style, refactor, test, chore, ci, perf, build, revert
#
# Install: git config core.hooksPath .githooks
#

MSG_FILE="$1"
SUBJECT=$(head -n 1 "$MSG_FILE")

# Allow merge/revert commits and fixup!/squash!
case "$SUBJECT" in
    Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\([a-z0-9-]+\))?: .{1,72}$'

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
    cat >&2 <<EOF
✗ Invalid commit message.

  Got:      "$SUBJECT"
  Expected: type(scope): description
  Types:    feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert
  Example:  feat(40-collections): add StationRepository with sorted views

  Rules:
  - Subject line only is checked (body is free-form)
  - ≤72 characters after the colon+space
  - scope is optional, lowercase-hyphenated

EOF
    exit 1
fi
