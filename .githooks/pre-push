#!/bin/sh
#
# Git pre-push hook — dev-oocol-fil-rouge
# Runs tests on changed modules (plus dependents). Static analysis is CI's job.
#
# Install: git config core.hooksPath .githooks
# Skip with: git push --no-verify (emergency WIP pushes)
#

set -e

# Find all files changed between remote tip and local HEAD
REMOTE=$(git rev-parse @{u} 2>/dev/null || echo "")
if [ -z "$REMOTE" ]; then
    # No upstream (first push) — full verify
    ./mvnw clean test -q -T 1C
    echo "✓ pre-push: full test suite passed (no upstream)"
    exit 0
fi

CHANGED=$(git diff --name-only "$REMOTE"..HEAD | grep -E '\.(java|xml|properties)$' || true)

if [ -z "$CHANGED" ]; then
    echo "✓ pre-push: no source changes, skipping tests"
    exit 0
fi

# Extract unique module directories
MODULES=$(echo "$CHANGED" | cut -d'/' -f1 | sort -u | grep -E '^[0-9]' || true)

# Parent pom changes → full reactor
if echo "$CHANGED" | grep -q '^pom\.xml$'; then
    MODULES=""
fi

if [ -z "$MODULES" ]; then
    ./mvnw clean test -q -T 1C
else
    PL=$(echo "$MODULES" | paste -sd ',' -)
    ./mvnw test -q -T 1C -pl "$PL" -am
fi

echo "✓ pre-push: tests passed"
