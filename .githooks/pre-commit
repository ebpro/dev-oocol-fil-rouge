#!/bin/sh
#
# Git pre-commit hook — dev-oocol-fil-rouge
# Fast compile-only check on changed modules.
# Full test suite is owned by pre-push and CI.
#
# Install: git config core.hooksPath .githooks
#

set -e

# Find changed Java/resource source files and map to modules
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(java|xml|properties)$' || true)

if [ -z "$CHANGED" ]; then
    exit 0
fi

# Extract unique module directories (first path component that matches a module)
MODULES=$(echo "$CHANGED" | cut -d'/' -f1 | sort -u | grep -E '^[0-9]' || true)

# Also include parent pom changes (affects all modules)
if echo "$CHANGED" | grep -q '^pom\.xml$'; then
    MODULES=""  # empty means full reactor
fi

if [ -z "$MODULES" ]; then
    # Full reactor compile (parent or non-module changes)
    ./mvnw compile -DskipTests -q -T 1C
else
    # Incremental: changed modules + their dependents
    PL=$(echo "$MODULES" | paste -sd ',' -)
    ./mvnw compile -DskipTests -q -T 1C -pl "$PL" -am
fi

echo "✓ pre-commit: compile OK"
