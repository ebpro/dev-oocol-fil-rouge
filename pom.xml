<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent agrégateur du fil rouge DEV-OOCOL (M1 Info & Math, UTLN / CNAM).

    Domaine : réseau de transport public urbain fictif (« Trans'U »).
    Architecture : un module Maven par instantané pédagogique (« snapshot-per-week »).
    Les modules sont INDÉPENDANTS (aucune dépendance inter-modules) : chaque semaine,
    le module courant se construit seul, ce qui permet aux étudiants de reprendre le
    fil rouge à n'importe quel point du semestre.

    Modules : voir docs/progression.md pour la mapping semaine/séance complète.
  -->
  <groupId>fr.ebruno.dev.oocol</groupId>
  <artifactId>dev-oocol-fil-rouge</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>dev-oocol-fil-rouge</name>
  <description>Fil rouge du cours DEV-OOCOL : projet Java multi-module guidé (domaine transport public)</description>
  <url>https://github.com/ebpro/dev-oocol-fil-rouge</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/ebpro/dev-oocol-fil-rouge</url>
    <connection>scm:git:https://github.com/ebpro/dev-oocol-fil-rouge.git</connection>
    <developerConnection>scm:git:ssh://git@github.com:ebpro/dev-oocol-fil-rouge.git</developerConnection>
  </scm>

  <developers>
    <developer>
      <id>bruno</id>
      <name>Emmanuel Bruno</name>
      <email>emmanuel.bruno@univ-tln.fr</email>
    </developer>
  </developers>

  <modules>
    <!-- Semaine 1-2 / Séances CNAM S1-S3 : chaîne d'outils, hello-world « transport » -->
    <module>00-scaffold</module>
    <!-- Semaine 3 / Séances CNAM S4-S5 : ELO 04 — classes, encapsulation, static, final -->
    <module>20-domain-bases</module>
    <!-- Semaine 4 / Séances CNAM S5-S6 : ELO 05 — héritage, classes abstraites, interfaces, polymorphisme -->
    <module>30-heritage</module>
    <!-- Semaine 5 / Séances CNAM S6-S7 : ELO 06 — collections (List/Set/Map/Queue), généricité, Comparable/Comparator, equals/hashCode -->
    <module>40-collections</module>
    <!-- Semaine 6 / Séance CNAM S9 : ELO 07 — exceptions checked/unchecked, try-with-resources, chaînage de causes, hiérarchie métier -->
    <module>50-exceptions</module>
    <!-- Semaine 7 / Séance CNAM S10 : ELO 08 — NIO.2 (Path, Files), chargement CSV, charset, écriture atomique, FileVisitor -->
    <module>60-io</module>
    <!-- Semaine 8 / Séance CNAM S11 : ELO 09 — sérialisation Java (Serializable, serialVersionUID, transient, Externalizable, versioning, pièges) -->
    <module>70-serialisation</module>
    <!-- Semaines 10-11 / Séances CNAM S12-S14 : ELO 11 — Java moderne (records, sealed, pattern matching, switch expressions, Streams, lambdas, var, text blocks, Optional) -->
    <module>80-modern-java</module>
    <!-- Semaine 11 / Enrichissement ELO 06 — chasse aux bugs : dix pièges classiques des collections (equals/hashCode, fuites mutables, CME, clés instables, comparateurs incohérents) avec miroirs corrigés -->
    <module>85-collection-pitfalls</module>
    <!-- Semaine 12 / Séances CNAM S15-S16 : ELO 12 — JDBC (DriverManager, PreparedStatement, ResultSet), motif DAO, transactions ACID, démonstration d'injection SQL, H2 en mémoire -->
    <module>90-jdbc</module>
    <!-- Semaines 13+ / Séances CNAM S17+ : ELO 13 — synthèse : motif Builder, rétrospective SOLID, CLI testable, persistance en couches (CSV + JDBC) -->
    <module>95-transit-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Java 21 = version minimale ET cible de compilation (LTS). Le code ne doit PAS
         utiliser de fonctionnalité post-21 ni de preview : code pédagogique. -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Builds reproductibles : horodatage figé des entrées d'archive. -->
    <project.build.outputTimestamp>2026-10-20T00:00:00Z</project.build.outputTimestamp>

    <!-- Versions centralisées des plugins (références validées sur java101-tp1, CI 21/25 verte) -->
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
    <spotbugs-maven-plugin.version>4.9.8.1</spotbugs-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
    <sonar-maven-plugin.version>5.5.0.6356</sonar-maven-plugin.version>

    <!-- Versions centralisées des dépendances -->
    <junit-jupiter.version>6.0.1</junit-jupiter.version>
    <assertj-core.version>3.27.7</assertj-core.version>

    <!-- Emplacement des règles d'analyse statique (résolu depuis chaque module) -->
    <filrouge.buildtools.dir>${maven.multiModuleProjectDirectory}/build-tools</filrouge.buildtools.dir>

    <!-- SonarQube : identité du projet + agrégation de la couverture JaCoCo.
         qualitygate.wait=false → le build ne bloque pas sur le quality gate
         (aucune référence établie sur ce dépôt pour l'instant). -->
    <sonar.projectKey>fr.ebruno.dev.oocol:dev-oocol-fil-rouge</sonar.projectKey>
    <sonar.projectName>Dev OOCOL Fil Rouge</sonar.projectName>
    <sonar.qualitygate.wait>false</sonar.qualitygate.wait>
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

    <!-- Exclusions: CLI/demo packages use System.out intentionally; test sources carry AssertJ style patterns that are the pedagogy -->
    <sonar.exclusions>**/app/**,**/cli/**,**/*Demo.java</sonar.exclusions>
    <sonar.test.exclusions></sonar.test.exclusions>
    <!-- Downgrade AssertJ pedagogical style rules via issue-retain (S5778 one-throwing-call-per-lambda, S5853 chained assertions, S5838 specialized containsEntry) -->
    <sonar.issue.ignore.multicriteria>e1,e2,e3,e4,e5,e6,e7,e8,e9,e10,e11,e12,e13,e14</sonar.issue.ignore.multicriteria>
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S5778</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/src/test/**</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S5853</sonar.issue.ignore.multicriteria.e2.ruleKey>
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/src/test/**</sonar.issue.ignore.multicriteria.e2.resourceKey>
    <sonar.issue.ignore.multicriteria.e3.ruleKey>java:S5838</sonar.issue.ignore.multicriteria.e3.ruleKey>
    <sonar.issue.ignore.multicriteria.e3.resourceKey>**/src/test/**</sonar.issue.ignore.multicriteria.e3.resourceKey>
    <!-- S1068 (unused private field) false positive on Java-serialization fields -->
    <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S1068</sonar.issue.ignore.multicriteria.e4.ruleKey>
    <sonar.issue.ignore.multicriteria.e4.resourceKey>70-serialisation/**</sonar.issue.ignore.multicriteria.e4.resourceKey>
    <!-- Module 85: pitfall fixtures contain intentional bugs (S1206 equals/compareTo, S5413 Boolean unboxing) -->
    <sonar.issue.ignore.multicriteria.e5.ruleKey>java:S1206</sonar.issue.ignore.multicriteria.e5.ruleKey>
    <sonar.issue.ignore.multicriteria.e5.resourceKey>85-collection-pitfalls/**</sonar.issue.ignore.multicriteria.e5.resourceKey>
    <sonar.issue.ignore.multicriteria.e6.ruleKey>java:S5413</sonar.issue.ignore.multicriteria.e6.ruleKey>
    <sonar.issue.ignore.multicriteria.e6.resourceKey>85-collection-pitfalls/**</sonar.issue.ignore.multicriteria.e6.resourceKey>
    <!-- Module 80: VersionLegacy intentionally demonstrates pre-Java-16 idioms (instanceof chains, anonymous Runnable) -->
    <sonar.issue.ignore.multicriteria.e7.ruleKey>java:S6201</sonar.issue.ignore.multicriteria.e7.ruleKey>
    <sonar.issue.ignore.multicriteria.e7.resourceKey>**/VersionLegacy.java</sonar.issue.ignore.multicriteria.e7.resourceKey>
    <sonar.issue.ignore.multicriteria.e8.ruleKey>java:S1604</sonar.issue.ignore.multicriteria.e8.ruleKey>
    <sonar.issue.ignore.multicriteria.e8.resourceKey>**/VersionLegacy.java</sonar.issue.ignore.multicriteria.e8.resourceKey>
    <!-- Console-identity classes: println IS the feature (TransitHello main; serialisation Station writeObject hook journalise, documented in Javadoc) -->
    <sonar.issue.ignore.multicriteria.e9.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e9.ruleKey>
    <sonar.issue.ignore.multicriteria.e9.resourceKey>**/TransitHello.java</sonar.issue.ignore.multicriteria.e9.resourceKey>
    <sonar.issue.ignore.multicriteria.e10.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e10.ruleKey>
    <sonar.issue.ignore.multicriteria.e10.resourceKey>**/serialisation/domain/Station.java</sonar.issue.ignore.multicriteria.e10.resourceKey>
    <!-- S3776 near-threshold (complexity 16 vs limit 15): NetworkBuilder validation pass is inherently branchy; documented pedagogically -->
    <sonar.issue.ignore.multicriteria.e11.ruleKey>java:S3776</sonar.issue.ignore.multicriteria.e11.ruleKey>
    <sonar.issue.ignore.multicriteria.e11.resourceKey>95-transit-app/src/main/java/fr/ebruno/dev/oocol/transit/domain/NetworkBuilder.java</sonar.issue.ignore.multicriteria.e11.resourceKey>
    <!-- Serialisation Station static counters: documented test hooks (class Javadoc L33-34, asserted in PitfallsTest) — incrementing them from the read/write hooks is the pedagogy -->
    <sonar.issue.ignore.multicriteria.e12.ruleKey>java:S2696</sonar.issue.ignore.multicriteria.e12.ruleKey>
    <sonar.issue.ignore.multicriteria.e12.resourceKey>**/serialisation/domain/Station.java</sonar.issue.ignore.multicriteria.e12.resourceKey>
    <!-- Module 40: anonymous Comparator et absence de computeIfAbsent sont une convention pedagogique
         documentee en code ("lambda reserve au module 80") -->
    <sonar.issue.ignore.multicriteria.e13.ruleKey>java:S1604</sonar.issue.ignore.multicriteria.e13.ruleKey>
    <sonar.issue.ignore.multicriteria.e13.resourceKey>40-collections/**</sonar.issue.ignore.multicriteria.e13.resourceKey>
    <sonar.issue.ignore.multicriteria.e14.ruleKey>java:S3824</sonar.issue.ignore.multicriteria.e14.ruleKey>
    <sonar.issue.ignore.multicriteria.e14.resourceKey>40-collections/**</sonar.issue.ignore.multicriteria.e14.resourceKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM JUnit : aligne api/engine/params/aggregate sur la même version -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj-core.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <!-- Builds reproductibles : pas d'entrée dépendante de la machine -->
              <addMavenDescriptor>false</addMavenDescriptor>
              <manifest>
                <addDefaultImplementationEntries>false</addDefaultImplementationEntries>
                <addDefaultSpecificationEntries>false</addDefaultSpecificationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <doclint>all</doclint>
            <failOnError>false</failOnError>
          </configuration>
        </plugin>

        <!-- ===== Analyse statique : NON BLOQUANTE au fil rouge (warn-only) =====
             Les étudiants apprennent à lire et corriger ces rapports au fil du semestre ;
             elles ne doivent jamais casser un build vert par ailleurs. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>${filrouge.buildtools.dir}/checkstyle.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <linkXRef>false</linkXRef>
            <failOnViolation>false</failOnViolation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${maven-pmd-plugin.version}</version>
          <configuration>
            <rulesets>
              <ruleset>${filrouge.buildtools.dir}/pmd-ruleset.xml</ruleset>
            </rulesets>
            <printFailingErrors>true</printFailingErrors>
            <linkXRef>false</linkXRef>
            <failOnViolation>false</failOnViolation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Low</threshold>
            <failOnError>false</failOnError>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Plugins hérités et exécutés par chaque module -->
    <plugins>
      <!-- Garde-fous d'environnement : JDK 21+, Maven 3.9+ (le wrapper fournit 3.9.8) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Couverture : agent au démarrage des tests, rapport au phase verify -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Analyse statique warn-only, branchée sur verify (voir pluginManagement) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-warn</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <executions>
          <execution>
            <id>pmd-warn</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotbugs-warn</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Scanner SonarQube : aucun goal lié au cycle de vie ; résout « sonar:sonar »
           à une version déterministe depuis le POM parent (hérité par les modules).
           L'URL et le token sont injectés par le workflow réutilisable via les
           variables d'environnement SONAR_HOST_URL / SONAR_TOKEN. -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar-maven-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
