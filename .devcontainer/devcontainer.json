{
  // Conteneur de développement du fil rouge DEV-OOCOL.
  // Ce dépôt utilise désormais le profil Solen « lang-java-25 » : l'image fournit
  // JDK 25 et Git, sans Maven global — le projet utilise le Maven wrapper (./mvnw)
  // livré dans le dépôt.
  "name": "dev-oocol-fil-rouge",
  "image": "ghcr.io/ebpro/solen:lang-java-25-v1.3.42",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven"
      ]
    }
  },
  "postCreateCommand": "git config core.hooksPath .githooks && chmod +x mvnw && ./mvnw -B -q --version",
  "remoteUser": "jovyan"
}
