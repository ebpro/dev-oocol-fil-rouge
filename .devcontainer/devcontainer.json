{
  // Conteneur de développement du fil rouge DEV-OOCOL.
  // Image JDK 25 (cible unique du projet), Git, sans Maven global :
  // le projet utilise le Maven wrapper (./mvnw) livré dans le dépôt.
  // NB : l'image Solen des dépôts de cours Quarto n'est PAS adaptée ici —
  // ce dépôt est un projet Java/Maven pur, sans rendu de supports.
  "name": "dev-oocol-fil-rouge",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "mavenVersion": "none",
      "javaToolchains": true
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "jebbs.plantuml",
        "shengchen.vscode-checkstyle",
        "redhat.vscode-xml"
      ]
    }
  },
  "postCreateCommand": "git config core.hooksPath .githooks && chmod +x mvnw && ./mvnw -B -q --version",
  "remoteUser": "vscode"
}
